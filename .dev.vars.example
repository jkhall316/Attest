# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.

# Default route: OpenRouter + gpt-oss-20b + mai-transcribe-2. One OpenRouter key covers summaries,
# Ask, speaker naming and transcription (see README "The recommended route").
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODELS=openai/gpt-oss-20b
DEFAULT_MODEL=openai/gpt-oss-20b
STT_BASE_URL=https://openrouter.ai/api/v1
STT_API_KEY=sk-or-...
STT_MODELS=microsoft/mai-transcribe-2

# Or OpenAI instead: comment out the OpenRouter block above and use just this one key.
# OPENAI_API_KEY=sk-...

# Fully local on a Mac (oMLX): easiest is `npm run setup:local`, which tests your server and
# writes these for you. By hand:
# LOCAL_MODE=true
# REQUIRE_ACCESS=false
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=your-omlx-key
# LLM_MODELS=mlx-community/gpt-oss-20b-MXFP4-Q8
# DEFAULT_MODEL=mlx-community/gpt-oss-20b-MXFP4-Q8
# LLM_CONTEXT_CHARS=98000                    # ~3 characters per token of your model's context window
# EMBED_MODEL=mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ   # semantic search (optional)
# STT_BASE_URL=http://localhost:8000/v1
# STT_API_KEY=your-omlx-key
# STT_MODELS=mlx-community/whisper-large-v3-turbo-asr-fp16
# LOCAL_DIARIZE=true                         # detect speakers in the browser by voice

# Optional: Pocket API key (pk_...) for "Import from Pocket".
# POCKET_API_KEY=pk_...

# Optional: Omi Developer API key (omi_dev_..., conversations:read) for "Import from Omi".
# Omi shares transcripts, not audio.
# OMI_API_KEY=omi_dev_...

# Planned features -- placeholders only, nothing reads these yet.
# RESEND_API_KEY=re_...
# DIGEST_FROM=notes@your-verified-domain.example
# LINEAR_API_KEY=lin_api_...
# TODOIST_API_TOKEN=...
# NOTION_TOKEN=secret_...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# MS_CLIENT_ID=...
# MS_CLIENT_SECRET=...
# STT_LANGUAGE=en   # pin the spoken language; stops Whisper looping when it misdetects
# HALLUCINATION_GUARD=off   # on by default; removes repeated-phrase and wrong-script junk from transcripts

# Conversation shaping (all optional; see README "Conversation shaping")
# SPLIT_GAP_MIN=5      # silence this long between speech = a different conversation
# TRIM_MIN_SEC=30      # dead air longer than this at the start or end is trimmed
# MERGE_GAP_MIN=3      # pieces of a call closer than this are joined before transcription
# RESHAPE=off          # turn trimming, splitting and joining off
